# === BASE DE DATOS ===
DATABASE_URL="postgresql://watchparty_user:TU_PASSWORD_SEGURA@localhost:5432/watchparty"

# === APP / AUTH ===
# Genera un secreto largo con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-largo-y-aleatorio"

# URL pública donde quedará expuesta la app
NEXTAUTH_URL="https://watchparty.tudominio.com"

# URL interna usada por tareas de fondo dentro del mismo VPS
INTERNAL_APP_URL="http://127.0.0.1:3001"

# Código único para entrar al panel admin
ADMIN_CODE="cambia-este-codigo-admin"

# === ALMACENAMIENTO LOCAL ===
# WatchParty queda configurado para guardar toda la multimedia
# en el mismo servidor donde corre la app.
STORAGE_MODE="local"
UPLOAD_DIR="/var/lib/watchparty/uploads"

# === NOTAS ===
# - Instala ffmpeg en el servidor para miniaturas y optimización local.
# - Si vas a usar otro puerto interno, ajusta INTERNAL_APP_URL.
# - Si cambias la ruta de uploads, asegúrate de que el proceso tenga permisos.
